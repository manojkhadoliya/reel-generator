# ElevenLabs API key — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# ElevenLabs voice ID to use for narration — https://elevenlabs.io/app/voice-library (copy the voice's ID)
# For Hindi reels (/reel ... | ... | hi), pick a Hindi-capable voice from the voice library —
# the eleven_multilingual_v2 model auto-detects the spoken language from the submitted text.
ELEVENLABS_VOICE_ID=

# AWS credentials for the IAM user/role with s3:PutObject on the reels bucket — https://console.aws.amazon.com/iam
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS region the S3 bucket lives in
AWS_REGION=ap-south-1

# S3 bucket that finished reels are uploaded to
S3_BUCKET=reel-generater

# Voiceover provider: "elevenlabs" (default) or "polly". Polly reuses the AWS credentials above
# (needs polly:SynthesizeSpeech) — useful as a free-tier fallback when ElevenLabs quota is exhausted.
TTS_PROVIDER=elevenlabs

# Only used when TTS_PROVIDER=polly. Voice ID from https://docs.aws.amazon.com/polly/latest/dg/available-voices.html
# Default "Matthew" is English (en-US). For Hindi reels, use "Kajal" (hi-IN, neural).
AWS_POLLY_VOICE_ID=Matthew
# Polly engine: "neural" (default, better quality) or "standard" — neural availability varies by AWS_REGION.
AWS_POLLY_ENGINE=neural
